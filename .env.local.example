# ──────────────────────────────────────────────
# Kit (ConvertKit) API
# ──────────────────────────────────────────────

# Your Kit v3 API key — find it at:
# https://app.kit.com/account_settings/developer_settings
KIT_API_KEY=your_kit_api_key_here

# Kit API base URL (leave as-is unless using a proxy)
KIT_API_BASE_URL=https://api.convertkit.com

# ──────────────────────────────────────────────
# Public social links (optional — set to "#" to hide)
# These are exposed to the browser (NEXT_PUBLIC_ prefix)
# ──────────────────────────────────────────────
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/yourhandle
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@yourchannel
NEXT_PUBLIC_SUBSTACK_URL=https://yourname.substack.com

# ──────────────────────────────────────────────
# Site URL (used for OG metadata, optional)
# ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
